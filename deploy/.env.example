# ============================================================
# Variables de entorno para el backend de OttoPOS en Render.
# Copia este archivo como .env en tu equipo (NUNCA subir datos
# reales al repositorio). En Render se definen como "Env Groups"
# o en el apartado Environment del Web Service.
# ============================================================

# URL de conexión a Aiven for MySQL (Free)
# Obtén estos datos en Aiven -> tu servicio MySQL ->
# "Connection info" (pestaña Service URI / SSL).
# La base se llama igual que el servicio (ej: defaultdb).
SPRING_DATASOURCE_URL=jdbc:mysql://AVIEN_HOST:AVIEN_PUERTO/defaultdb?ssl-mode=REQUIRED

# Usuario y contraseña que aparecen en la misma pestaña
# (usuario típico: avnadmin)
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=TU_CONTRASENA_DE_AIVEN

# Puerto (Render lo asigna solo; no lo cambies)
PORT=8081